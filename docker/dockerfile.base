# syntax=docker/dockerfile:1
ARG TARGETPLATFORM
ARG BUILDPLATFORM
FROM --platform=$TARGETPLATFORM ubuntu:22.04

# Install base utilities with architecture-specific optimizations
RUN apt-get update \
    && apt-get install -y build-essential wget python3-distutils curl ca-certificates \
    && if [ "$(uname -m)" = "aarch64" ]; then \
        apt-get install -y gcc-aarch64-linux-gnu g++-aarch64-linux-gnu; \
    fi \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install miniconda
ENV CONDA_DIR=/opt/conda
ENV PATH=$CONDA_DIR/bin:$PATH

# Use architecture detection to download the correct Miniconda installer with Apple Silicon optimizations
RUN arch=$(uname -m) && \
    echo "Building for architecture: $arch on platform: $TARGETPLATFORM" && \
    if [ "$arch" = "x86_64" ]; then \
        wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O ~/miniconda.sh; \
    elif [ "$arch" = "aarch64" ]; then \
        wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-aarch64.sh -O ~/miniconda.sh; \
    else \
        echo "Unsupported architecture: $arch"; \
        exit 1; \
    fi && \
    /bin/bash ~/miniconda.sh -b -p /opt/conda \
    && rm ~/miniconda.sh

# Configure conda for ARM64 optimization when applicable
RUN if [ "$(uname -m)" = "aarch64" ]; then \
        conda config --add channels conda-forge; \
        conda config --set channel_priority strict; \
    fi

# Create base environment with minimal dependencies
COPY src/services/base/environment.yml .
RUN conda env create --name service -f environment.yml